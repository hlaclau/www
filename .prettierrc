{
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "arrowParens": "always",
    "printWidth": 80,
    "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
    "tailwindStylesheet": "./src/styles/global.css",
    "overrides": [{ "files": "*.astro", "options": { "parser": "astro" } }]
}
