---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/constants/site';
import { LinkedInButton, GitHubButton, OpGGButton } from '@/components/sections/SocialButton';
---

<Layout title="Contact" description={`Contactez ${SITE.username} - ${SITE.title}`}>
  <div class="flex flex-col items-center justify-center min-h-[60vh] space-y-10 text-center">
    <div class="space-y-6 max-w-3xl mx-auto w-full">
      {/* Title */}
      <div class="space-y-4">
        <h1 class="text-foreground text-3xl font-bold md:text-4xl">
          Contactez-moi
        </h1>
      </div>

      {/* Description */}
      <div class="text-muted-foreground text-base md:text-lg leading-relaxed">
        <p>
          Vous avez une question ou simplement envie de discuter ? 
          N'hésitez pas à me contacter! 
        </p>
      </div>

      {/* Social Links */}
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <LinkedInButton href={SITE.contact.linkedin} client:load />
        <GitHubButton href={SITE.contact.github} client:load />

      </div>

    </div>
  </div>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact",
  "description": `Contactez ${SITE.username} - ${SITE.title}`,
  "url": `${SITE.url}/contact`,
  "mainEntity": {
    "@type": "Person",
    "name": SITE.username,
    "url": SITE.url,
    "sameAs": [
      SITE.contact.linkedin,
      SITE.contact.github
    ]
  }
})}>
</script>
