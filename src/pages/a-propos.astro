---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/constants/site';
import Description from '@/components/sections/Description.astro';
import Skills from '@/components/sections/Skills.astro';
---

<Layout title="À propos" description={`En savoir plus sur ${SITE.username} - ${SITE.description}`}>
  <div class="flex flex-col items-center space-y-6 text-center">
    <div class="space-y-2">
      <h1 class="text-foreground text-3xl font-bold md:text-4xl">
        À propos de moi
      </h1>
    </div>
    <Description />
    <Skills />
  </div>
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "À propos",
  "description": `En savoir plus sur ${SITE.username} - ${SITE.description}`,
  "url": `${SITE.url}/a-propos`,
  "mainEntity": {
    "@type": "Person",
    "name": SITE.username,
    "jobTitle": SITE.title,
    "worksFor": {
      "@type": "Organization",
      "name": SITE.company
    },
    "knowsAbout": SITE.keywords
  }
})}>
</script>
