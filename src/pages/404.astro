---
import Layout from '@/layouts/Layout.astro';
import { SITE } from '@/constants/site';
---

<Layout title="404" description="Page not found">
  <div class="flex flex-col items-center justify-center text-center space-y-6">
    <h1 class="text-foreground text-6xl md:text-7xl font-bold">
      404
    </h1>
    <p class="text-muted-foreground text-lg md:text-xl">
        Cette page n'existe pas! :(
    </p>
    <a 
      href="/"
      class="text-foreground hover:text-primary transition-colors underline underline-offset-2 mt-4"
    >
      Retour à l'accueil
    </a>
  </div>
</Layout>

