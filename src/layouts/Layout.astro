---
import '@/styles/global.css';
import { SITE } from '@/constants/site';
import { LAST_MODIFIED } from '@/lib/last-modified';
import Analytics from '@vercel/analytics/astro';
import Nav from '@/components/ui/nav.astro';
import WaveBackground from '@/components/ui/wave-background.astro';

export interface Props {
    title: string;
    description?: string;
    image?: string;
    canonical?: string;
    noindex?: boolean;
}

const {
    title,
    description = SITE.description,
    image = SITE.image,
    canonical,
    noindex = false,
} = Astro.props;

const siteURL = Astro.site || SITE.url;
const canonicalURL = canonical || new URL(Astro.url.pathname, siteURL);
const socialImage = new URL(image, siteURL);
// Home: "Hugo Laclau | Développeur .NET & AWS à Bordeaux", other pages: "Page | Hugo Laclau"
const isHomePage = title === SITE.username;
const pageTitle = isHomePage
    ? `${SITE.username} | ${SITE.titleSuffix}`
    : `${title} | ${SITE.username}`;

const personId = `${SITE.url}/#person`;
const websiteId = `${SITE.url}/#website`;

const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Person',
            '@id': personId,
            name: SITE.username,
            givenName: 'Hugo',
            familyName: 'Laclau',
            alternateName: 'hlaclau',
            description: SITE.description,
            url: SITE.url,
            image: {
                '@type': 'ImageObject',
                url: new URL(SITE.image, SITE.url).toString(),
                width: 1200,
                height: 630,
            },
            sameAs: [SITE.contact.github, SITE.contact.linkedin],
            jobTitle: SITE.title,
            worksFor: {
                '@type': 'Organization',
                name: SITE.company,
                url: SITE.company_url,
            },
            address: {
                '@type': 'PostalAddress',
                addressLocality: 'Bordeaux',
                addressRegion: 'Nouvelle-Aquitaine',
                addressCountry: 'FR',
            },
            nationality: {
                '@type': 'Country',
                name: 'France',
            },
            knowsAbout: SITE.keywords,
            knowsLanguage: [
                { '@type': 'Language', name: 'French', alternateName: 'fr' },
                { '@type': 'Language', name: 'English', alternateName: 'en' },
            ],
            alumniOf: {
                '@type': 'EducationalOrganization',
                name: SITE.school,
                address: {
                    '@type': 'PostalAddress',
                    addressLocality: 'Bordeaux',
                    addressCountry: 'FR',
                },
            },
            hasOccupation: {
                '@type': 'Occupation',
                name: 'Software Engineer',
                occupationLocation: {
                    '@type': 'City',
                    name: 'Bordeaux',
                },
                skills: SITE.keywords.slice(0, 10).join(', '),
            },
        },
        {
            '@type': 'WebSite',
            '@id': websiteId,
            name: SITE.username,
            url: SITE.url,
            description: SITE.description,
            inLanguage: 'fr-FR',
            author: { '@id': personId },
            publisher: { '@id': personId },
        },
        ...(isHomePage
            ? [
                  {
                      '@type': 'ProfilePage',
                      '@id': `${SITE.url}/#profilepage`,
                      url: SITE.url,
                      name: `Profil de ${SITE.username}`,
                      description: SITE.description,
                      inLanguage: 'fr-FR',
                      isPartOf: { '@id': websiteId },
                      mainEntity: { '@id': personId },
                      dateCreated: '2025-12-11',
                      ...(LAST_MODIFIED && { dateModified: LAST_MODIFIED }),
                  },
              ]
            : []),
    ],
};
---

<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=5.0"
        />

        <!-- Primary Meta Tags -->
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <meta name="author" content={SITE.username} />

        <link rel="canonical" href={canonicalURL} />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        {!noindex && (
            <meta
                name="robots"
                content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
            />
        )}

        <!-- Theme & Mobile App -->
        <meta
            name="theme-color"
            content="#000000"
            media="(prefers-color-scheme: dark)"
        />
        <meta
            name="theme-color"
            content="#ffffff"
            media="(prefers-color-scheme: light)"
        />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta
            name="apple-mobile-web-app-status-bar-style"
            content="black-translucent"
        />
        <meta name="apple-mobile-web-app-title" content={SITE.username} />
        <link rel="apple-touch-icon" href="/favicon.png" />
        <link rel="manifest" href="/manifest.json" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="profile" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:alt" content={pageTitle} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:site_name" content={SITE.username} />
        <meta property="og:locale" content="fr_FR" />
        <meta property="profile:first_name" content="Hugo" />
        <meta property="profile:last_name" content="Laclau" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content={pageTitle} />

        <!-- Structured Data -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify(structuredData)}
        />
        <script is:inline>
            (function () {
                const theme = localStorage.getItem('theme') || 'dark';
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            })();
        </script>
        <Analytics />
    </head>
    <body class="bg-background min-h-screen">
        <WaveBackground />

        {/* Navbar - fixed top right */}
        <div class="fixed top-0 right-0 z-20 px-6 py-5 md:px-10">
            <Nav />
        </div>

        {/* Main Content Area */}
        <main class="relative z-10 flex min-h-screen justify-center px-6 py-28 md:px-10 md:py-32">
            <div class="w-full max-w-2xl">
                <slot />
            </div>
        </main>
    </body>
</html>
