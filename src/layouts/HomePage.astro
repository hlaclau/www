---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/sections/Hero.astro';
import Contact from '@/components/sections/Contact.astro';
import SectionLabel from '@/components/ui/section-label.astro';
import { SITE } from '@/constants/site';
---

<Layout title={SITE.username} description={SITE.description}>
    <div class="flex flex-col gap-16 md:gap-20">
        <Hero />

        <div class="flex flex-col gap-6">
            <SectionLabel index="01" title="About" />
            <div class="mdx drop-cap text-muted-foreground max-w-2xl space-y-5 text-lg leading-relaxed">
                <slot />
            </div>
        </div>

        <div class="flex flex-col gap-6">
            <SectionLabel index="02" title="Contact" />
            <Contact />
        </div>
    </div>
</Layout>
