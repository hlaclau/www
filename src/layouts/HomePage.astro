---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/sections/Hero.astro';
import Contact from '@/components/sections/Contact.astro';
import { SITE } from '@/constants/site';
---

<Layout title={SITE.username} description={SITE.description}>
  <div class="flex flex-col items-center space-y-12 md:space-y-16">
    <Hero />
    <div class="mdx w-full max-w-2xl mx-auto space-y-6 text-muted-foreground leading-relaxed">
      <slot />
    </div>
    <Contact />
  </div>
</Layout>
