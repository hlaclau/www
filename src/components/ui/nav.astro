---
import ThemeToggle from './theme-toggle.astro';
import { OTHER_LOCALE, getLocale, homePath, ui } from '@/i18n';

interface Props {
    className?: string;
}

const { className = '' } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const other = OTHER_LOCALE[locale];
---

<nav class:list={['flex items-center gap-1', className]}>
    <a
        href={homePath(other)}
        hreflang={other}
        lang={other}
        aria-label={ui[locale].switchLanguage}
        class="mono-label text-muted-foreground hover:text-foreground px-2 transition-colors"
    >
        {other.toUpperCase()}
    </a>
    <ThemeToggle />
</nav>
