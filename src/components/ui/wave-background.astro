---
---

<canvas
    id="wave-bg"
    class="pointer-events-none fixed inset-0 z-0"
    aria-hidden="true"
    style="mask-image: radial-gradient(ellipse 420px 60% at 50% 40%, rgb(0 0 0 / 0.35), black); -webkit-mask-image: radial-gradient(ellipse 420px 60% at 50% 40%, rgb(0 0 0 / 0.35), black);"
></canvas>

<script>
    const canvas = document.getElementById('wave-bg') as HTMLCanvasElement;
    const ctx = canvas?.getContext('2d');

    if (canvas && ctx) {
        const prefersReducedMotion = window.matchMedia(
            '(prefers-reduced-motion: reduce)'
        ).matches;

        let width = 0;
        let height = 0;
        let rafId = 0;
        let time = 0;
        let lastFrame = 0;
        let visible = true;

        const SCALE = Math.min(window.devicePixelRatio || 1, 2);
        // a bit above 60 so frame jitter on 60Hz screens never skips a frame,
        // while 120Hz+ screens are still capped around 60fps
        const FRAME_MS = 1000 / 70;

        // contour field: evenly spaced horizontal lines warped by a pair of
        // counter-rotating vortices, which twist the lines into an S-shaped
        // swirl. The vortices drift and breathe slowly over time.
        const vortices = [
            { x: 0.47, y: 0.42, radius: 0.26, strength: 2.0, seed: 0 },
            { x: 0.57, y: 0.58, radius: 0.2, strength: -1.3, seed: 2.4 },
        ];
        const SPACING = 48;
        const STEP = 6;

        // mouse parallax: lines follow the pointer vertically by different
        // amounts depending on their depth, while the swirl drifts the other
        // way. `target` is where the pointer is, `pointer` eases toward it.
        const PARALLAX = 80;
        const EASE = 0.1;
        const target = { x: 0, y: 0 };
        const pointer = { x: 0, y: 0 };

        const resize = () => {
            width = window.innerWidth;
            height = window.innerHeight;
            canvas.width = width * SCALE;
            canvas.height = height * SCALE;
            canvas.style.width = `${width}px`;
            canvas.style.height = `${height}px`;
            ctx.setTransform(SCALE, 0, 0, SCALE, 0, 0);
        };

        const isDarkMode = () =>
            document.documentElement.classList.contains('dark');

        // rotate a point around each vortex centre, by an angle that is
        // strongest at the centre and falls off smoothly with distance
        const warp = (x: number, y: number, t: number) => {
            const size = Math.max(width, height);
            for (const v of vortices) {
                const cx =
                    width * v.x +
                    Math.sin(t * 0.0035 + v.seed) * size * 0.03 -
                    pointer.x * PARALLAX * 0.6;
                const cy =
                    height * v.y +
                    Math.cos(t * 0.003 + v.seed) * size * 0.02 -
                    pointer.y * PARALLAX * 0.6;
                const r = size * v.radius;
                const dx = x - cx;
                const dy = y - cy;
                const falloff = Math.exp(-(dx * dx + dy * dy) / (r * r));
                const angle =
                    v.strength * (1 + Math.sin(t * 0.005 + v.seed) * 0.2) * falloff;
                const cos = Math.cos(angle);
                const sin = Math.sin(angle);
                x = cx + dx * cos - dy * sin;
                y = cy + dx * sin + dy * cos;
            }
            return [x, y] as const;
        };

        const draw = () => {
            const dark = isDarkMode();
            const c = dark ? '255, 255, 255' : '0, 0, 0';
            const alpha = dark ? 0.34 : 0.16;
            ctx.clearRect(0, 0, width, height);

            // lines fade in from the left edge, like the light falls across them
            const stroke = ctx.createLinearGradient(0, 0, width, 0);
            stroke.addColorStop(0, `rgba(${c}, ${alpha * 0.15})`);
            stroke.addColorStop(0.5, `rgba(${c}, ${alpha * 0.7})`);
            stroke.addColorStop(1, `rgba(${c}, ${alpha})`);
            ctx.strokeStyle = stroke;
            ctx.lineWidth = 1.2;

            // overscan vertically so lines rotated in from off-screen exist
            const overscan = height * 0.5;
            for (let y0 = -overscan; y0 <= height + overscan; y0 += SPACING) {
                // neighbouring lines sit at nearby depths so they never cross
                const depth = 0.5 + 0.5 * Math.sin(y0 / 160);
                const shift = pointer.y * PARALLAX * depth;
                ctx.beginPath();
                for (let x0 = -40; x0 <= width + 40; x0 += STEP) {
                    const swell = Math.sin(x0 / 420 + y0 / 300 + time * 0.004) * 14;
                    const [x, y] = warp(x0, y0 + swell + shift, time);
                    if (x0 === -40) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                }
                ctx.stroke();
            }
        };

        const render = (now: number) => {
            if (!visible) return;
            rafId = requestAnimationFrame(render);
            // 60fps so the parallax tracks the pointer smoothly
            if (now - lastFrame < FRAME_MS) return;
            lastFrame = now;
            // half a tick per frame keeps the ambient drift at its 30fps pace
            time += 0.5;
            pointer.x += (target.x - pointer.x) * EASE;
            pointer.y += (target.y - pointer.y) * EASE;
            draw();
        };

        resize();
        draw();

        window.addEventListener('resize', () => {
            resize();
            draw();
        });

        // redraw immediately when the theme toggles
        new MutationObserver(draw).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['class'],
        });

        if (!prefersReducedMotion) {
            rafId = requestAnimationFrame(render);

            // only real mice, touch would make the lines jump on every tap
            if (window.matchMedia('(pointer: fine)').matches) {
                window.addEventListener('pointermove', (e) => {
                    target.x = (e.clientX / width) * 2 - 1;
                    target.y = (e.clientY / height) * 2 - 1;
                });
                // settle back to rest when the pointer leaves the window
                document.documentElement.addEventListener('pointerleave', () => {
                    target.x = 0;
                    target.y = 0;
                });
            }

            document.addEventListener('visibilitychange', () => {
                visible = !document.hidden;
                cancelAnimationFrame(rafId);
                if (visible) rafId = requestAnimationFrame(render);
            });
        }
    }
</script>
