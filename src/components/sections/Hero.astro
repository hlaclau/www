---
import { SITE } from '@/constants/site';
import { getLocale } from '@/i18n';

const title = SITE.localized[getLocale(Astro.currentLocale)].title;
---

<div class="flex flex-col items-center gap-5 text-center">
    <h1 class="text-foreground font-display text-6xl leading-[1.05] font-normal italic tracking-tight md:text-7xl lg:text-8xl">
        {SITE.username}
    </h1>

    <p class="text-muted-foreground text-lg italic md:text-xl">{title}</p>

    <div class="rule max-w-xs"></div>
</div>
