---
import { SITE } from '@/constants/site';
---

<div class="flex flex-col items-center gap-5 text-center">
    <p class="mono-label flex items-center gap-2">
        <span class="bg-accent shadow-accent/60 inline-block h-2 w-2 rounded-full shadow-[0_0_6px]"></span>
        {SITE.location}
    </p>

    <h1
        class="text-foreground font-display text-6xl leading-[1.05] font-normal italic tracking-tight md:text-7xl lg:text-8xl"
    >
        {SITE.username}
    </h1>

    <p class="text-muted-foreground text-lg italic md:text-xl">
        {SITE.title}
    </p>

    <div class="rule max-w-xs"></div>
</div>
